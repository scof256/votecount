// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    POLLING_AGENT
    SUPERVISOR
    ADMINISTRATOR
}

enum SubmissionStatus {
    PENDING
    VERIFIED
    FLAGGED_ANOMALY
    REJECTED
}

// Application-specific models
model User {
    id                  String           @id @default(cuid())
    name                String?
    email               String?          @unique
    emailVerified       DateTime?
    image               String?
    role                Role             @default(POLLING_AGENT)
    submissions         VoteSubmission[]
    auditLogs           AuditLog[]
    assignedPollingStationId String?          @unique
    assignedPollingStation PollingStation?  @relation(fields: [assignedPollingStationId], references: [id])
}

model PollingStation {
    id          String           @id @default(cuid())
    name        String
    location    String?
    agent       User?
    submissions VoteSubmission[]
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt
}

model Election {
    id        String     @id @default(cuid())
    name      String     // e.g., "General Election 2026"
    date      DateTime
    positions Position[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
}

model Position {
    id              String           @id @default(cuid())
    title           String           // e.g., "President", "Member of Parliament"
    electionId      String
    election        Election         @relation(fields: [electionId], references: [id])
    candidates      Candidate[]
    voteSubmissions VoteSubmission[]
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
}

model Candidate {
    id             String          @id @default(cuid())
    name           String
    politicalParty String?
    positionId     String
    position       Position        @relation(fields: [positionId], references: [id])
    voteCounts     CandidateVote[]
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
}

model VoteSubmission {
    id                      String           @id @default(cuid())
    pollingStationId        String
    pollingStation          PollingStation   @relation(fields: [pollingStationId], references: [id])
    positionId              String
    position                Position         @relation(fields: [positionId], references: [id])
    submittedById           String
    submittedBy             User             @relation(fields: [submittedById], references: [id])
    votes                   CandidateVote[]
    declarationFormImages   Image[]
    aiResult                AIResult?
    status                  SubmissionStatus @default(PENDING)
    notes                   String?
    createdAt               DateTime         @default(now())
    updatedAt               DateTime         @updatedAt
}

model CandidateVote {
    id           String         @id @default(cuid())
    submissionId String
    submission   VoteSubmission @relation(fields: [submissionId], references: [id])
    candidateId  String
    candidate    Candidate      @relation(fields: [candidateId], references: [id])
    voteCount    Int

    @@unique([submissionId, candidateId])
}

model Image {
    id           String         @id @default(cuid())
    url          String // URL to the stored image (e.g., S3 bucket)
    submissionId String
    submission   VoteSubmission @relation(fields: [submissionId], references: [id])
    uploadedAt   DateTime       @default(now())
}

model AIResult {
    id                   String         @id @default(cuid())
    submissionId         String         @unique
    submission           VoteSubmission @relation(fields: [submissionId], references: [id])
    ocrData              Json?
    benfordTestResult    Float?
    dipTestResult        Float?
    skewness             Float?
    kurtosis             Float?
    incrementalFraudProb Float?
    extremeFraudProb     Float?
    anomalyScore         Float?
    isFlagged            Boolean        @default(false)
    processedAt          DateTime       @default(now())
}

model AuditLog {
    id        String   @id @default(cuid())
    action    String
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    details   Json?
    createdAt DateTime @default(now())
}